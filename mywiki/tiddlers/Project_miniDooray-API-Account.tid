<tr><td>userPassword</td><td>O</td><td>String</td><td>max 100, 공백 불가</td></tr>
<tr><td>userEmail</td><td>O</td><td>String</td><td>max 50, 이메일 형식</td></tr>
<tr><td>userName</td><td>O</td><td>String</td><td>max 50, 공백 불가</td></tr>
</table>
